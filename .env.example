# Backend environment variables

# Required
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-strong-secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Origins
CLIENT_ORIGIN=http://localhost:3000
ADMIN_PANEL_ORIGIN=http://localhost:5173

# Optional: Cloudflare R2 Storage (zero-egress secondary storage)
# Create a free account at https://dash.cloudflare.com/ → R2
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=wallpaper-assets
# R2_PUBLIC_URL=https://your-bucket.r2.dev

# Optional: 3rd-Party Wallpaper API Keys (all free)
# Pexels: https://www.pexels.com/api/
# PEXELS_API_KEY=your_pexels_api_key

# Pixabay: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your_pixabay_api_key

# Wallhaven: https://wallhaven.cc/settings/account
# WALLHAVEN_API_KEY=your_wallhaven_api_key

# Unsplash: https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key
